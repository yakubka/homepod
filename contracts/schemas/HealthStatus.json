{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthStatus",
  "description": "Liveness and readiness of the Pi services, returned by GET /health. status is the worst status of the critical components api, bus, engine and bridge. degradations lists every degraded mode in force, see docs/degraded.md.",
  "type": "object",
  "required": [
    "status",
    "ts",
    "service_version",
    "contract_version",
    "uptime_s",
    "components",
    "degradations"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "common.json#/$defs/ComponentStatus",
      "description": "Overall status."
    },
    "ts": {
      "$ref": "common.json#/$defs/Timestamp",
      "description": "Server time, ISO 8601 UTC. Clients may use it to detect clock skew."
    },
    "service_version": {
      "$ref": "common.json#/$defs/SemVer",
      "description": "API service version."
    },
    "contract_version": {
      "$ref": "common.json#/$defs/SemVer",
      "description": "Contract version the API was built against."
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds since API start."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ComponentHealth"
      },
      "description": "One entry per component, at most one per name."
    },
    "degradations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Degradation"
      },
      "description": "Degraded modes in force, empty when the room runs normally, at most one entry per flag."
    }
  },
  "$defs": {
    "HealthComponent": {
      "title": "HealthComponent",
      "description": "Component reported in health. esp32 is the microcontroller as seen through the bridge, database is the API store.",
      "type": "string",
      "enum": [
        "api",
        "bus",
        "engine",
        "bridge",
        "esp32",
        "vision",
        "voice",
        "recorder",
        "database"
      ]
    },
    "ComponentHealth": {
      "title": "ComponentHealth",
      "description": "Health of one component.",
      "type": "object",
      "required": [
        "name",
        "status",
        "last_seen_at",
        "detail",
        "uptime_s",
        "restarts"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/HealthComponent",
          "description": "Component."
        },
        "status": {
          "$ref": "common.json#/$defs/ComponentStatus",
          "description": "Component status."
        },
        "last_seen_at": {
          "description": "Last bus message or heartbeat from the component, ISO 8601 UTC, null when never seen.",
          "anyOf": [
            {
              "$ref": "common.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "Short explanation when not ok, otherwise null."
        },
        "uptime_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Seconds since the component last started, null when it is not running."
        },
        "restarts": {
          "type": "integer",
          "minimum": 0,
          "description": "Times the supervisor restarted the component since core started."
        }
      }
    },
    "DegradationFlag": {
      "title": "DegradationFlag",
      "description": "device_link_lost means the ESP32 link is down, sensor values are stale and actuator calls fail with device_unavailable. vision_unavailable means camera or detector are down and occupancy comes from the presence sensor with null counts. stt_unavailable means speech to text is down and voice answers with the fallback sentence. internet_unavailable means general questions fail with a spoken sentence while local intents work. over_budget means the scheduler is shedding vision, then general questions. service_failed means the supervisor gave up restarting a service, named in detail.",
      "type": "string",
      "enum": [
        "device_link_lost",
        "vision_unavailable",
        "stt_unavailable",
        "internet_unavailable",
        "over_budget",
        "service_failed"
      ]
    },
    "Degradation": {
      "title": "Degradation",
      "description": "One degraded mode in force.",
      "type": "object",
      "required": [
        "flag",
        "since",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "flag": {
          "$ref": "#/$defs/DegradationFlag",
          "description": "Which degraded mode."
        },
        "since": {
          "$ref": "common.json#/$defs/Timestamp",
          "description": "When it began, ISO 8601 UTC."
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "Short explanation, null when the flag says it all."
        }
      }
    }
  },
  "examples": [
    {
      "status": "ok",
      "ts": "2026-10-13T08:55:05.000Z",
      "service_version": "0.3.1",
      "contract_version": "1.0.0",
      "uptime_s": 86400,
      "components": [
        {
          "name": "api",
          "status": "ok",
          "last_seen_at": "2026-10-13T08:55:05.000Z",
          "detail": null,
          "uptime_s": 86400,
          "restarts": 0
        },
        {
          "name": "bus",
          "status": "ok",
          "last_seen_at": "2026-10-13T08:55:05.000Z",
          "detail": null,
          "uptime_s": 86400,
          "restarts": 0
        },
        {
          "name": "engine",
          "status": "ok",
          "last_seen_at": "2026-10-13T08:55:04.100Z",
          "detail": null,
          "uptime_s": 86400,
          "restarts": 0
        },
        {
          "name": "bridge",
          "status": "ok",
          "last_seen_at": "2026-10-13T08:55:04.900Z",
          "detail": null,
          "uptime_s": 86400,
          "restarts": 0
        },
        {
          "name": "esp32",
          "status": "ok",
          "last_seen_at": "2026-10-13T08:55:03.500Z",
          "detail": null,
          "uptime_s": 86400,
          "restarts": 0
        },
        {
          "name": "vision",
          "status": "degraded",
          "last_seen_at": "2026-10-13T08:55:04.000Z",
          "detail": "Running at 0.5 fps, target is 1 fps.",
          "uptime_s": 86400,
          "restarts": 0
        },
        {
          "name": "voice",
          "status": "ok",
          "last_seen_at": "2026-10-13T08:55:02.000Z",
          "detail": null,
          "uptime_s": 86400,
          "restarts": 0
        }
      ],
      "degradations": []
    },
    {
      "status": "degraded",
      "ts": "2026-10-20T09:31:05.000Z",
      "service_version": "0.4.0",
      "contract_version": "1.0.3",
      "uptime_s": 900,
      "components": [
        {
          "name": "api",
          "status": "ok",
          "last_seen_at": "2026-10-20T09:31:05.000Z",
          "detail": null,
          "uptime_s": 900,
          "restarts": 0
        },
        {
          "name": "vision",
          "status": "ok",
          "last_seen_at": "2026-10-20T09:31:04.000Z",
          "detail": null,
          "uptime_s": 41,
          "restarts": 1
        },
        {
          "name": "bridge",
          "status": "degraded",
          "last_seen_at": "2026-10-20T09:31:03.000Z",
          "detail": "ESP32 link down",
          "uptime_s": 900,
          "restarts": 0
        }
      ],
      "degradations": [
        {
          "flag": "device_link_lost",
          "since": "2026-10-20T09:30:58.120Z",
          "detail": "no uplink frame, serial port closed"
        }
      ]
    }
  ]
}
